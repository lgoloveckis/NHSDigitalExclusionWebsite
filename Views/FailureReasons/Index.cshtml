@model IEnumerable<NHSDigitalExclusionWebsite.Models.FailureReason>

@{
    ViewData["Title"] = "Failure Reasons";
}

<h1>Failure Reasons</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ReasonName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReasonDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RiskPoints)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.ReasonName)
            </td>
            <td>
                @Html.DisplayFor(model => item.ReasonDescription)
            </td>
            <td>
                @Html.DisplayFor(model => item.RiskPoints)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ReasonId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ReasonId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ReasonId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
