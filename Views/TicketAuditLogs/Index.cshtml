@model IEnumerable<NHSDigitalExclusionWebsite.Models.TicketAuditLog>

@{
    ViewData["Title"] = "Audit Logs";
}

<h1>Audit Logs</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TicketId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OldStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NewStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ChangedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ChangedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Notes)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.TicketId)
            </td>
            <td>
                @Html.DisplayFor(model => item.OldStatus)
            </td>
            <td>
                @Html.DisplayFor(model => item.NewStatus)
            </td>
            <td>
                @Html.DisplayFor(model => item.ChangedBy)
            </td>
            <td>
                @Html.DisplayFor(model => item.ChangedDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.Notes)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.AuditId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.AuditId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.AuditId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
